# Public Matrix server credentials (where you export from)
PUBLIC_HOMESERVER=https://matrix.org
PUBLIC_USER_ID=@yourname:matrix.org
PUBLIC_PASSWORD=your_public_password
PUBLIC_RECOVERY_KEY=EsTm...
PUBLIC_ACCESS_TOKEN=
PUBLIC_DEVICE_ID=

# Private local homeserver credentials (where you import to)
PRIVATE_HOMESERVER=http://localhost:8008
APPSERVICE_TOKEN=generate_a_strong_random_token_here
ADMIN_TOKEN=your_admin_access_token_here